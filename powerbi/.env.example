# Copy this file to the repo root as ".env" and fill in your values.
# .env is git-ignored - never commit it.

# Supabase > Project Settings > Database > Connection string (Session pooler)
# Use port 5432 with sslmode=require. URL-encode special characters in the password.
# Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.abcdefg:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres